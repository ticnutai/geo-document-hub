  "rsDes": [
    {
      "MMI_MEETING_ID": 4027025.0,
      "DISTINCT_NAME": "מרכז",
      "COMMITTE_NAME": "ועדה מחוזית לתכנון ולבניה מחוז המרכז - ועדת משנה להתנגדויות",
      "CM_NAME": "ועדה מחוזית לתכנון ולבניה מחוז המרכז",
      "FO_NAME": "ועדת משנה להתנגדויות",
      "FO_SUB_FORUM_OF": 10.0,
      "MEETING_NO": 2003007.0,
      "MEETING_DATE": "23/02/2003",
      "ENTITY_DOC_ID": 388601.0,
      "ATTACHMENT_ID": 666178.0,
      "FILE_TYPE": "pdf       ",
      "ENTITY_DOC_ID1": null,
      "ATTACHMENT_ID1": null,
      "FILE_TYPE1": null,
      "ENTITY_DOC_ID_10": null,
      "ATTACHMENT_ID_10": null,
      "FILE_TYPE_10": null,
      "ENTITY_DOC_ID_110": null,
      "ATTACHMENT_ID_110": null,
      "FILE_TYPE_110": null,
      "MEETING_CODE": 4027025.0,
      "MMI_DESICIONS": "הוחלט:\r\n\r\nלתוכנית הוגשו שלוש התנגדויות מטעם חברת כביש חוצי ישראל בע\"מ, רשות שדות התעופה, ויזם התוכנית כפר חב\"ד. לאחר שמיעת נציגי המתנגדים מחליטה הועדה כדלקמן:\r\nא.\tהתנגדות חברת כביש חוצה ישראל בע\"מ באמצעות עו\"ד רמי סופר ואח', \r\nחברת כביש חוצה ישראל טענה כי מאחר והתוכנית קרובה לפרוייקט חניון חנה וסע המתוכנן על ידה במסגרת תוכנית מח/150 (שהוחלט להפקידה בתנאים ואולם טרם הופקדה בפועל) יש לחייב את מגישי תוכנית זו (כפר חב\"ד) למגן את המבנים המוצעים בתוכניתם מפני רעש הצפוי להיגרם מהחניון חנה וסע. לאחר שקילת טענה זו מחליטה הועדה לדחות את דרישת כביש חוצה ישראל. תוכנית זו מתוכננת מזה שנים רבות, (משנת 1997) והופקדה בפועל לפני תוכנית מח/150. ככל שנדרש מיגון לבתים החדשים בכפר חב\"ד כתוצאה מתוכנית מח/150 אז על תוכנית מח/150 לדאוג לביצוע המיגון. למעלה מן הצורך נוסיף ונציין כי תוכנית זו מבטיחה מיגון דירתי למבנים בהתאם להוראות תמא/2/4 (לנושא רעש מטוסים). וכן סוללה אקוסטית מכביש מס' 1.\r\n \r\n\r\nב.\tהתנגדות רשות שדות התעופה\r\nרשות שדות התעופה חזרה על התנגדותה הכתובה מיום 14/1/03 במספר נושאים, כאשר חלקים מההתנגדות עוסקים בכפר חב\"ד ולחלקם התנגד הישוב.  לאחר שמיעת הצדדים מחליטה הועדה כלדקמן:\r\n1.\tלמטרות התוכנית יתווסף סעיף ה' בהתאם למפורט בסעיף 6א' לכתב ההתנגדות בתאום עם לשכת התכנון.\r\n2.\tבנושא נספח אקוסטי - לדחות את ההתנגדות שכן לתוכנית נערך נספח אקוסטי ומסקנותיו הוטמעו בהוראות התוכנית.\r\n3.\tלקבל את סעיף 6ג' בהתנגדות ולמחוק את הסיפא של סעיף 15.1 להוראות התוכנית.\r\n4.\tביחס לסעיפים 7 ו-8 להתנגדות הועדה מחליטה כי תנאי למתן תוקף לתוכנית יהיה רישום הערת אזהרה תכנונית בדבר המצאות המקרקעין בתחום התוכנית בתחום רעש מטוסים לפי תמא/2/4. נוסח ההערה יקבע בתיאום עם לשכת התכנון. הועדה רואה חשיבות רבה לכך שרוכשי זכויות במקרקעין יהיו מודעים למגבלות הרעש הנובעים מהשדה.\r\n\r\nג.\tהתנגדות כפר חב\"ד\r\nמגישי התוכנית הגישו אכן התנגדות למספר נושאים תכנוניים שבתוכנית. לאחר בחינת התנגדותם מחליטה הועדה כדלקמן:\r\n1.\tביחס לקו בניין צידי - הועדה מחליטה לקבל את ההתנגדות באופן שבמגרשים המפורטים בסעיף 1 לכתב ההתנגדות מיום 5/1/03 תותר הקטנה של קו הבניין הצידי עד כדי 3 מ' ובלבד שהמרחק בין שני בניינים גובלים לא יקטן מ-7 מ' במרחק צידי. כמו כן",
      "ENTITY_DOC_ID_20": null,
      "ATTACHMENT_ID_20": null,
      "FILE_TYPE_20": null
    },
