רים</td><td class="clsTableCell">22A</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">1756</td><td class="clsTableCell"><sup>(7)</sup> 291.36</td><td class="clsTableCell"><sup>(2)</sup> 72.5</td><td class="clsTableCell"><sup>(3)</sup> 100</td><td class="clsTableCell"><sup>(8)</sup> 1</td><td class="clsTableCell"><sup>(4)</sup> 9.5</td><td class="clsTableCell">2</td><td class="clsTableCell">1</td><td class="clsTableCell"><sup>(5)</sup></td><td class="clsTableCell"><sup>(5)</sup></td><td class="clsTableCell"><sup>(6)</sup></td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="מגורים בישוב כפרי"><td  class="clsTableCell"></td><td class="clsTableCell">מגורים בישוב כפרי</td><td class="clsTableCell">פעילות לא חקלאית</td><td class="clsTableCell">22A</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">1756</td><td class="clsTableCell"><sup>(9)</sup> 500</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(9)</sup> 5.2</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(5)</sup></td><td class="clsTableCell"><sup>(5)</sup></td><td class="clsTableCell"><sup>(5)</sup></td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="קרקע חקלאית"><td  class="clsTableCell"></td><td class="clsTableCell">קרקע חקלאית</td><td class="clsTableCell">קרקע חקלאית</td><td class="clsTableCell">1022</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(10)</sup></td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(11)</sup></td><td class="clsTableCell"><sup>(12)</sup></td><td class="clsTableCell"><sup>(13)</sup></td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="סכום"><td  class="clsTableCell">סך הכל</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">1022</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">4362</td><td class="clsTableCell">1106.36</td><td class="clsTableCell">217.5</td><td class="clsTableCell">300</td><td class="clsTableCell">3</td><td class="clsTableCell">33.7</td><td class="clsTableCell">6</td><td class="clsTableCell">3</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td></tr></tbody></table><br><br><Table border=1><TR><TD><B>מספר</B></TD><TD><B>הערות לטבלת זכויות והוראות בניה - מצב מוצע</B></TD></TR><TR><TD>1</TD><TD> למשפחה מרובת ילדים על כל נפש מעל ל-6 נפשות במשפחה תינתן תוספת של 15 מ''ר לכל נפש (משפחה לעניין זה היא הורים, ילדיהם שאינם נשואים והורים זקנים הגרים דרך קבע עימם)  ולא יותר מ- 350 מ"ר עיקרי בדירה.</TD></TR><TR><TD>2</TD><TD> 60 מ"ר שרות למטרת אחסון, חניה, מערכות טכניות, ועוד 12.5 מ"ר עבור ממ"ד - שטח נטו 9 מ"ר ועוד שטח קירות הממ"ד.</TD></TR><TR><TD>3</TD><TD> למטרת אחסון, חניה, מערכות טכניות, בליטות וממ"ד.</TD></TR><TR><TD>4</TD><TD> 9.5 מ' עבור גג משופע או 8.5 מ' עבור גג שטוח.</TD></TR><TR><TD>5</TD><TD> לפי תשריט.</TD></TR><TR><TD>6</TD><TD> לפי תשריט, למעט חניה ומחסן עד 0 בהסכמת שכן.</TD></TR><TR><TD>7</TD><TD> ליח"ד הורים עד 55 מ"ר, למשפחה מרובת ילדים על כל נפש מעל ל-6 נפשות במשפחה תינתן תוספת של 15 מ''ר לכל נפש (משפחה לעניין זה היא הורים, ילדיהם שאינם נשואים והורים זקנים הגרים דרך קבע עימם)  ולא יותר מ- 350 מ"ר עיקרי בדירה.</TD></TR><TR><TD>8</TD><TD> 1 יח"ד + יח"ד הורים במבנה אחד.</TD></TR><TR><TD>9</TD><TD> בהתאם להוראות תכנית גז/1000.</TD></TR><TR><TD>10</TD><TD> בהתאם להחלטת הועדה המקומית ולפי טבלת ההצבה של משרד החקלאות.</TD></TR><TR><TD>11</TD><TD> 5 מ' או 0.</TD></TR><TR><TD>12</TD><TD> 30 מ' מהחזית.</TD></TR><TR><TD>13</TD><TD> 3 מ' או 0 בהסכמת שכן.</TD></TR></Table><br><br><Table border=1><TR><TD><B>הערות ברמת טבלה</B></TD></TR><TR><TD>שטח הבניה העיקרי המוצע בתכנית הינו: 450 מ"ר המותרים + 6% משטח המגרש למגורים שהם 156.36 מ"ר (6% X 2,606), סה"כ שטח עיקרי בתכנית 606.36 מ"ר.

יותר ניוד של שטח הממ"ד מקומות עליונות לקומת המרתף ללא צורך בהקלה.
מרווח בין מבנים לחקלאות 3 מ'.</TD></TR></Table><br><br>