</sup> 258.86</td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(4)</sup> 1</td><td class="clsTableCell">11</td><td class="clsTableCell">3</td><td class="clsTableCell">1</td><td class="clsTableCell"><sup>(5)</sup></td><td class="clsTableCell"><sup>(5)</sup></td><td class="clsTableCell"><sup>(6)</sup></td><td class="clsTableCell"><sup>(5)</sup></td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="מגורים בישוב כפרי"><td  class="clsTableCell"></td><td class="clsTableCell">מגורים בישוב כפרי</td><td class="clsTableCell">פעילות לא חקלאית</td><td class="clsTableCell">8A</td><td class="clsTableCell">תחום חצר המגורים בחלקה א'</td><td class="clsTableCell">1626</td><td class="clsTableCell"><sup>(7)</sup> 500</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">7</td><td class="clsTableCell"><sup>(7)</sup></td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(5)</sup></td><td class="clsTableCell"><sup>(5)</sup></td><td class="clsTableCell"><sup>(6)</sup></td><td class="clsTableCell">5</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="קרקע חקלאית"><td  class="clsTableCell"></td><td class="clsTableCell">קרקע חקלאית</td><td class="clsTableCell">קרקע חקלאית</td><td class="clsTableCell">1008</td><td class="clsTableCell">חקלאי בחלקה א'</td><td class="clsTableCell">4155</td><td class="clsTableCell"><sup>(8)</sup></td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(9)</sup></td><td class="clsTableCell"><sup>(9)</sup></td><td class="clsTableCell"><sup>(10)</sup></td><td class="clsTableCell"><sup>(10)</sup></td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="סכום"><td  class="clsTableCell">סך הכל</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">1008</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">8407</td><td class="clsTableCell">1358.86</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">5</td><td class="clsTableCell">40</td><td class="clsTableCell">9</td><td class="clsTableCell">3</td><td class="clsTableCell">3.7</td><td class="clsTableCell">5.4</td><td class="clsTableCell">2</td><td class="clsTableCell">13</td></tr></tbody></table><br><br><Table border=1><TR><TD><B>מספר</B></TD><TD><B>הערות לטבלת זכויות והוראות בניה - מצב מוצע</B></TD></TR><TR><TD>1</TD><TD> למשפחה מרובת ילדים , על כל נפש מעל ל 6- נפשות במשפחה , תינתן תוספת של 15 מ''ר לכל נפש ( משפחה לעניין זה היא , הורים , ילדיהם שאינם נשואים והורים מבוגרים הגרים דרך קבע עימם) ולא יותר מ- 350 מ''ר בדירה.</TD></TR><TR><TD>2</TD><TD> בנוסף תותר קומת מרתף בשטח שלא יחרוג ממסגרת הקומה שמעליו ,השימושים במרתף יהיו עפ"י השימושים הקבועים בתקנה 9 ד' לתקנות חישוב שטחים .</TD></TR><TR><TD>3</TD><TD> בנוסף תותר קומת מרתף בשטח שלא יחרוג ממסגרת הקומה שמעליו ,השימושים במרתף יהיו עפ''י השימושים הקבועים בתקנה 9 ד' לתקנות חישוב שטחים .</TD></TR><TR><TD>4</TD><TD> יח"ד  ראשית ועוד יחידת הורים .</TD></TR><TR><TD>5</TD><TD> לפי תשריט.</TD></TR><TR><TD>6</TD><TD> עד גבול השטח המיועד למגורים.</TD></TR><TR><TD>7</TD><TD> עפ"י גז/1000.</TD></TR><TR><TD>8</TD><TD> עפ''י טבלת ההצבה של משרד החקלאות.עפ"י הנחיות שה"מ במשרד החקלאות.</TD></TR><TR><TD>9</TD><TD> קו בניין צדדי למבנה משק חקלאי - 3 מ' או 0 בהסכמת השכן ובתנאי שניקוז הגגות יופנה למגרש המבקש,בכפוף לטבלת ההצבה של משרד החקלאות והנחיות שה"מ במשרד החקלאות.</TD></TR><TR><TD>10</TD><TD> עפ"י תשריט.</TD></TR></Table><br><br><Table border=1><TR><TD><B>הערות ברמת טבלה</B></TD></TR><TR><TD>א-שטח הבנייה העיקרי :450 מ"ר מתכניות קודמות+ 6% (הקלה כמותית - 157.56 מ"ר ) ,2.5% (תוספת קומה שלישית  65.65 מ"ר),2.5% (בגין תוספת מרתף  65.65 מ"ר), 120 מ"ר (שחושבו כשירות בתכניות קודמות), סה"כ  858.86 מ"ר
ב-בנוסף, יותרו שטחי בניה עבור מרחבים מוגנים עבור כל יח"ד ( עפ"י הנחיות פיקוד העורף המתעדכנים מעת לעת).
ג-ניתן לנייד זכויות בנייה למגורים, למעט זכויות בנייה מתחת לכניסה הקובעת אל מעל הכניסה הקובעת, באישור הוועדה המקומית.</TD></TR></Table><br><br>