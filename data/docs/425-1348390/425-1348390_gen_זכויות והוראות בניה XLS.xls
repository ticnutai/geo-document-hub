</sup> 1</td><td class="clsTableCell">11</td><td class="clsTableCell">3</td><td class="clsTableCell">1</td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="מגורים בישוב כפרי"><td  class="clsTableCell"></td><td class="clsTableCell">מגורים בישוב כפרי</td><td class="clsTableCell">פעילות לא חקלאית</td><td class="clsTableCell">50A</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">921</td><td class="clsTableCell"><sup>(6)</sup> 500</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(6)</sup> 5.2</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="מגורים בישוב כפרי"><td  class="clsTableCell"></td><td class="clsTableCell">מגורים בישוב כפרי</td><td class="clsTableCell">קרקע חקלאית</td><td class="clsTableCell">50A</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">921</td><td class="clsTableCell"><sup>(7)</sup></td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="קרקע חקלאית"><td  class="clsTableCell"></td><td class="clsTableCell">קרקע חקלאית</td><td class="clsTableCell">קרקע חקלאית</td><td class="clsTableCell">1050</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">3317</td><td class="clsTableCell"><sup>(7)</sup></td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(8)</sup></td><td class="clsTableCell"><sup>(9)</sup></td><td class="clsTableCell"><sup>(10)</sup></td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="סכום"><td  class="clsTableCell">סך הכל</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">1050</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">6915</td><td class="clsTableCell">1255.5</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">3</td><td class="clsTableCell">38.2</td><td class="clsTableCell">9</td><td class="clsTableCell">3</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td></tr></tbody></table><br><br><Table border=1><TR><TD><B>מספר</B></TD><TD><B>הערות לטבלת זכויות והוראות בניה - מצב מוצע</B></TD></TR><TR><TD>(1)</TD><TD> למשפחה מרובת ילדים על כל נפש מעל ל-6 נפשות במשפחה תינתן זכות לתוספת של 15 מ''ר לכל נפש (משפחה לעניין זה היא הורים, ילדיהם שאינם נשואים והורים)  ולא יותר מ- 350 מ"ר עיקרי בדירה .</TD></TR><TR><TD>(2)</TD><TD> תותר קומת מרתף בקונטור הקומה שמעליו בנוסף לזכויות.</TD></TR><TR><TD>(3)</TD><TD> לפי תשריט.</TD></TR><TR><TD>(4)</TD><TD> לפי תשריט, פרגולה בנויה או סככה עד קו בנין 0.</TD></TR><TR><TD>(5)</TD><TD> יחידה ראשית בשטח 355.5 מ"ר + יחידת הורים בשטח 55 מ"ר הצמודה ליח"ד הראשית.</TD></TR><TR><TD>(6)</TD><TD> לפי הוראות תכנית גז/1000.</TD></TR><TR><TD>(7)</TD><TD> בהתאם להחלטת הועדה המקומית ולפי טבלת ההצבה של משרד החקלאות.</TD></TR><TR><TD>(8)</TD><TD> 5 מ' או 0.</TD></TR><TR><TD>(9)</TD><TD> 30 מ' מהחזית.</TD></TR><TR><TD>(10)</TD><TD> 3 או 0 בהסכמת השכן.</TD></TR></Table><br><br><Table border=1><TR><TD><B>הערות ברמת טבלה</B></TD></TR><TR><TD>א. השטחים מעל הקרקע המוצעים בתכנית הינם: 450 מ"ר + 105 מ"ר (1,757X6%) + 43 מ"ר (1,757X2.5%) + 120 מ"ר (שהיו בתכנית קודמת שטחי שירות למחסנים, חניה מקורה ועוד) + 37.5 מ"ר (3 ממ"דים - לכל אחת מהיחידות) - סה"כ שטח מוצע בתכנית מעל הקרקע: 755.5 מ"ר
ב. למשפחה מרובת ילדים על כל נפש מעל ל-6 נפשות במשפחה תינתן זכות לתוספת של 15 מ''ר לכל נפש (משפחה לעניין זה היא הורים, ילדיהם שאינם נשואים והורים)  ולא יותר מ- 350 מ"ר עיקרי בדירה .
ג. מרווח בין מבנים לחקלאות 3 מ'.</TD></TR></Table><br><br>