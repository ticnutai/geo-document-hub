bsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="קרקע חקלאית"><td  class="clsTableCell"></td><td class="clsTableCell">קרקע חקלאית</td><td class="clsTableCell">חקלאי פתוח</td><td class="clsTableCell">601</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">3127</td><td class="clsTableCell"><sup>(8)</sup></td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(9)</sup> 0</td><td class="clsTableCell"><sup>(9)</sup> 0</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="סכום"><td  class="clsTableCell">סך הכל</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">803</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">7503</td><td class="clsTableCell">1081.28</td><td class="clsTableCell">120</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">50</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">4</td><td class="clsTableCell">14.7</td><td class="clsTableCell">2</td><td class="clsTableCell">3</td><td class="clsTableCell">3</td><td class="clsTableCell">5</td><td class="clsTableCell">5</td></tr></tbody></table><br><br><Table border=1><TR><TD><B>מספר</B></TD><TD><B>הערות לטבלת זכויות והוראות בניה - מצב מוצע</B></TD></TR><TR><TD>(1)</TD><TD> 450 מ''ר לפי גז/12/525+ 131.28 + במסגרת 6% הקלה בגין שיפור דיור, משפחה מרובת ילדים המונה מעל 6 נפשות מותרת תוספת בניה של 15 מ' לכל נפש, הורים נספרים לעניין מספר הנפשות.</TD></TR><TR><TD>(2)</TD><TD> למטרת אחסון, חניה, מערכות טכניות ובליטות..</TD></TR><TR><TD>(3)</TD><TD> 3 יח''ד + יח''ד הורים  בסה''כ 3 מבנים.</TD></TR><TR><TD>(4)</TD><TD> או 0 בהסכמת שכן למבנה שרות.</TD></TR><TR><TD>(5)</TD><TD> למעט קו בנין קדמי לחניה 1.5 מ'.</TD></TR><TR><TD>(6)</TD><TD> שטח מקסימלי לשימושי פלח בכפוף להוראות תכנית גז/1000.</TD></TR><TR><TD>(7)</TD><TD> בכפוף לתכנית גז/1000.</TD></TR><TR><TD>(8)</TD><TD> באישור הוועדה המקומית ובהמלצת משרד החקלאות.</TD></TR><TR><TD>(9)</TD><TD> בהסכמת השכן בתנאי השגת פתרון ניקוז הגגות שיכוון למגרש המבקש..</TD></TR></Table><br><br><Table border=1><TR><TD><B>הערות ברמת טבלה</B></TD></TR><TR><TD>א. יח"ד בשטח שלא יפחת מ- 160 מ"ר
ב. תכנית גז/1000 חלה על מגרש זה במלואה, כל המגבלות וההוראות של תכנית גז/1000 חלות במקרקעין.</TD></TR></Table><br><br>