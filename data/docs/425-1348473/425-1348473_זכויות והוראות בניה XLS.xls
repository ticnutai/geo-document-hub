ell">11</td><td class="clsTableCell">3</td><td class="clsTableCell">1</td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(4)</sup></td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="סכום"><td  class="clsTableCell">סך הכל</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">728</td><td class="clsTableCell">382.98</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">3</td><td class="clsTableCell">33</td><td class="clsTableCell">9</td><td class="clsTableCell">3</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td></tr></tbody></table><br><br><Table border=1><TR><TD><B>מספר</B></TD><TD><B>הערות לטבלת זכויות והוראות בניה - מצב מוצע</B></TD></TR><TR><TD>1</TD><TD> בנוסף, למשפחה מרובת ילדים על כל נפש מעל ל-6 נפשות במשפחה תינתן זכות לתוספת של 15 מ''ר לכל נפש (משפחה לעניין זה היא הורים, ילדיהם שאינם נשואים והורים זקנים הגרים דרך קבע עימם) ולא יותר מ- 350 מ"ר עיקרי בדירה .</TD></TR><TR><TD>2</TD><TD> תותר קומת מרתף בקונטור הקומה שמעליו בנוסף לזכויות.</TD></TR><TR><TD>3</TD><TD> לפי תשריט.</TD></TR><TR><TD>4</TD><TD> לפי תשריט, או 0 בקיר ללא פתחים בין מגרשים 137A ,137B, 137C.</TD></TR></Table><br><br><Table border=1><TR><TD><B>הערות ברמת טבלה</B></TD></TR><TR><TD>השטחים מעל הקרקע המוצעים בתכנית הינם: 255 מ"ר + 50 מ"ר (לפי סעיף קטן 17.ב) + 18 מ"ר (729X2.5%) + 60 מ"ר (שהיו בתכנית קודמת שטחי שירות למחסנים, חניה מקורה ועוד שטח לממ"ד לכל יח"ד לפי התקנות העדכניות ליום הוצאת ההיתר- סה"כ שטח מוצע לא כולל ממ"דים בתכנית מעל הקרקע: 383 מ"ר.
בנוסף, למשפחה מרובת ילדים על כל נפש מעל ל-6 נפשות במשפחה תינתן זכות לתוספת של 15 מ''ר לכל נפש (משפחה לעניין זה היא הורים, ילדיהם שאינם נשואים והורים)  ולא יותר מ- 350 מ"ר עיקרי בדירה.
יותר ניוד זכויות בניה למגורים בתחום המגרש, ללא הגבלה בתכסית, למעט זכויות מתחת לכניסה הקובעת אל מעל הכניסה הקובעת, באישור הועדה המקומית</TD></TR></Table><br><br>